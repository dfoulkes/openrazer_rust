# SPDX-License-Identifier: GPL-2.0-or-later
#
# Grants access to the ONE /dev/hidraw* node per supported Razer device that this
# userspace driver actually talks to — the USB control interface.
#
# Upstream OpenRazer's own udev rules set permissions on the usb/input/hid
# subsystems for the devices its kernel module manages, but they do NOT grant
# access to /dev/hidraw* itself. Without a rule like this one the hidraw nodes
# are root:root mode 0600 and razerd cannot open them as a normal user.
#
# Install:
#   sudo cp udev/60-razer-rust.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --action=add --subsystem-match=hidraw
#
# THE FILENAME NUMBER MATTERS. It must sort BEFORE systemd's
# /usr/lib/udev/rules.d/73-seat-late.rules, which contains:
#
#     TAG=="uaccess|xaccess-*", ENV{MAJOR}!="", RUN{builtin}+="uaccess"
#
# That is the line that actually applies the ACL. A rule numbered 99 sets the
# tag long after rule 73 has looked for it: the tag shows up in `udevadm info`
# (CURRENT_TAGS=:uaccess:seat:) and the ACL is never written, which looks for
# all the world like the rule "didn't apply". It did — it was just too late.
# Hence 60, matching the convention used by Steam (60-) and KDE Connect (40-).
#
# Verify with `getfacl /dev/hidrawN` and look for a NAMED entry:
#     user:yourname:rw-      <- correct
#     user::rw-              <- this is the OWNER (root), not you
#
# ---------------------------------------------------------------------------
# WHY THESE RULES ARE NARROW, AND WHY THAT MATTERS
# ---------------------------------------------------------------------------
#
# Reading a /dev/hidraw* node returns the device's raw HID *input* reports. On a
# keyboard's input interface that means keystrokes — every one of them, including
# those typed into other applications, outside whatever isolation Wayland or X11
# provides. Granting a login session read access to a keyboard's hidraw node is
# therefore equivalent to granting it a keylogger, and it is a standing grant:
# it applies whether or not razerd is running.
#
# That is very likely why the kernel ships /dev/hidraw* as root-only, and why
# upstream OpenRazer does not hand it out. So these rules match on the exact
# product AND the exact USB interface number this driver needs — the control
# interface, which carries no keystrokes:
#
#   BlackWidow V4 Pro  0x028d  interface 03   (razer-devices: report_index 0x03)
#   Basilisk V3 Pro    0x00aa  interface 00   (razer-devices: report_index 0x00)
#   Basilisk V3 Pro    0x00ab  interface 00   (wireless)
#
# Every other hidraw node on the device — including the keyboard's interface 0,
# which is the one that carries what you type — keeps its default root-only
# permissions.
#
# If you add a device to crates/razer-devices/src/table.rs, add its (idProduct,
# bInterfaceNumber) pair here too. Do NOT broaden these to
# `ATTRS{idVendor}=="1532"` alone: that matches every interface on every Razer
# device, keystroke-carrying ones included.
#
# NOTE ON SAFETY: these rules only set permissions. They contain no RUN+=, do
# not bind or unbind drivers, and cannot affect whether your keyboard types.
# (Upstream OpenRazer's rule does run a helper that rebinds drivers, which is a
# different and riskier proposition.)

# Preferred: hand access to whoever is logged in at the local seat, via
# systemd-logind ACLs. Needs no group to exist and no user to be added to one,
# so it works out of the box on any systemd distro.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="028d", ATTRS{bInterfaceNumber}=="03", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00aa", ATTRS{bInterfaceNumber}=="00", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00ab", ATTRS{bInterfaceNumber}=="00", TAG+="uaccess"

# Fallback for headless, multi-seat, or non-systemd setups, where `uaccess`
# does not apply. Create a group, add yourself to it, then uncomment:
#
#   sudo groupadd -f razer && sudo usermod -aG razer "$USER"
#
# Adjust the group name if you already use another one (OpenRazer users, for
# example, may prefer GROUP="openrazer"). Keep the idProduct/bInterfaceNumber
# match — a group-based rule that drops it hands the whole group a keylogger.
#
#SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="028d", ATTRS{bInterfaceNumber}=="03", GROUP="razer", MODE="0660"
#SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00aa", ATTRS{bInterfaceNumber}=="00", GROUP="razer", MODE="0660"
#SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="00ab", ATTRS{bInterfaceNumber}=="00", GROUP="razer", MODE="0660"
